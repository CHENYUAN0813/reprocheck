  "services": [
    {
      "id": "web",
      "runtime": "node",
      "directory": "Frontend",
      "install": [
        "npm",
        "ci"
      ],
      "test": [
        "npm",
        "run",
        "test"
      ],
      "build": [
        "npm",
        "run",
        "build"
      ],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--host",
        "0.0.0.0",
        "--port",
