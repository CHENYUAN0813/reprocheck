    {
      "id": "api",
      "runtime": "python",
      "directory": ".",
      "install": [
        "pip",
        "install",
        "-r",
        "Backend/requirements.txt"
      ],
      "test": [],
      "build": [],
      "start": [
        "python",
        "-m",
        "uvicorn",
        "Backend.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "port": 8000,
      "readyPath": "/health",
      "dependsOn": [],
      "env": {
        "AUTH_MODE": "demo"
      },
      "generatedEnv": [
        "REGENERATION_SIGNING_KEY",
        "GEMINI_API_KEY"
      ]
    }
  ],
  "browser": {
    "service": "web",
    "path": "/",
    "expectedText": "Dashboard",
    "requiredApi": [
